FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# For MySQL deployment, use: mysql+pymysql://<user>:<password>@<host>/<database>?charset=utf8mb4
# SQLite stores the local development database under instance/careerbridge.db.
DATABASE_URL=sqlite:///careerbridge.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
